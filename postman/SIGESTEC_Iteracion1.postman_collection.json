          ],
          "path": [
            "ordenes-trabajo"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solicitudId\": \"{{solicitudId}}\",\n  \"tecnicoId\": 1,\n  \"ssomaId\": 2,\n  \"apoyoId\": null,\n  \"tecnicosAdicionales\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  var r = pm.response.json();",
              "  pm.collectionVariables.set('ordenTrabajoId', r.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "CU05 - Listar OT (programación requiere PDF multipart)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ordenes-trabajo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
